+    // Steam Frame: FRAME_WORLD_SCALE (set by the launch wrapper) overrides the
+    // starting value, so the felt size of the world can be tuned without the
+    // Page Up/Down keys. Clamped to the same range Game_LeanScale allows.
+    float InitialWorldScale() noexcept
+    {
+        char value[32]{};
+        if (GetEnvironmentVariableA("FRAME_WORLD_SCALE",value,sizeof value))
